# Exemplo de variáveis de ambiente — copia para .env e preenche.
# NUNCA comitar o ficheiro .env real (está no .gitignore).

# --- Supabase (chaves públicas "anon" — seguras para o cliente) ---
SUPABASE_PROJECT_ID="o-teu-project-id"
SUPABASE_PUBLISHABLE_KEY="eyJ...anon-key..."
SUPABASE_URL="https://o-teu-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="o-teu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ...anon-key..."
VITE_SUPABASE_URL="https://o-teu-project-id.supabase.co"

# --- IA (servidor apenas — configurar no painel de deploy) ---
# LOVABLE_API_KEY — usada pelo tutor IA (apenas server-side)
# TUTOR_MODEL — opcional; por omissão "google/gemini-3-flash-preview"

# --- Stripe (Lovable Cloud Payments) ---
# VITE_PAYMENTS_CLIENT_TOKEN — token público do cliente (pk_live_… em produção)
# STRIPE_SANDBOX_API_KEY / STRIPE_LIVE_API_KEY — apenas server-side
# PAYMENTS_SANDBOX_WEBHOOK_SECRET / PAYMENTS_LIVE_WEBHOOK_SECRET — apenas server-side
